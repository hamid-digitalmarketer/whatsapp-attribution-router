# WhatsApp Attribution Router Environment Variables Example

# Core Application
APP_NAME="WhatsApp Attribution Router"
ENV=development
HOST=0.0.0.0
PORT=8000
API_KEY=war_dev_secret_key_12345
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=524288

# Google Sheets Integration
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME="Attribution Leads"
GOOGLE_APPLICATION_CREDENTIALS=

# GoHighLevel (GHL) CRM Integration
GHL_ENABLED=false
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_BASE_URL=https://services.leadconnectorhq.com

# Generic Outbound Webhook Integration
OUTBOUND_WEBHOOK_ENABLED=false
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
OUTBOUND_WEBHOOK_TIMEOUT_SECONDS=10.0
OUTBOUND_WEBHOOK_MAX_RETRIES=3
